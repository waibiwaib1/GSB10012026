pression | JsonAST.JSONObjectExpression,\n) => {\n\treturn node.parent.type === \"JSONProperty\" ? node.parent : node;\n};\n\nexport const rule = createRule({\n\tcreate(context) {\n\t\treturn {\n\t\t\tJSONArrayExpression(node: JsonAST.JSONArrayExpression) {\n\t\t\t\tif (!node.elements.length) {\n\t\t\t\t\treport(context, getNode(node));\n\t\t\t\t}\n\t\t\t},\n\t\t\tJSONObjectExpression(node: JsonAST.JSONObjectExpression) {\n\t\t\t\tif (!node.properties.length) {\n\t\t\t\t\treport(context, getNode(node));\n\t\t\t\t}\n\t\t\t},\n\t\t};\n\t},\n\tmeta: {\n\t\tdocs: {\n\t\t\tcategory: \"Best Practices\",\n\t\t\tdescription: \"Reports on unnecessary empty arrays and objects.\",\n\t\t\trecommended: true,\n\t\t},\n\t\thasSuggestions: true,\n\t\tmessages: {\n\t\t\temptyExpression:\n\t\t\t\t\"This {{expressionType}} does nothing and can be removed.\",\n\t\t\temptyFields:\n\t\t\t\t\"The field '{{field}}' does nothing and can be removed.\",\n\t\t\tremove: \"Remove this empty field.\",\n\t\t},\n\t\tschema: [],\n\t\ttype: \"suggestion\",\n\t},\n});\n"],"mappings":"AAEA;AAAA,EACC;AAAA,EACA;AAAA,OACM;AAGP,SAAS,kBAA0C;AAEnD,MAAM,sBAAsB,CAC3B,SAOI;AACJ,UAAQ,KAAK,MAAM;AAAA,IAClB,KAAK;AACJ,aAAO;AAAA,QACN,MAAM;AAAA,UACL,gBAAgB;AAAA,QACjB;AAAA,QACA,WAAW;AAAA,MACZ;AAAA,IACD,KAAK;AACJ,aAAO;AAAA,QACN,MAAM;AAAA,UACL,gBAAgB;AAAA,QACjB;AAAA,QACA,WAAW;AAAA,MACZ;AAAA,IACD,KAAK;AACJ,aAAO;AAAA,QACN,MAAM;AAAA,UACL,OAAQ,KAAK,IAAkC;AAAA,QAChD;AAAA,QACA,WAAW;AAAA,MACZ;AAAA,EACF;AACD;AAEA,MAAM,SAAS,CACd,SACA,SAII;AACJ,QAAM,EAAE,MAAM,UAAU,IAAI,oBAAoB,IAAI;AACpD,UAAQ,OAAO;AAAA,IACd;AAAA,IACA;AAAA,IACA;AAAA,IACA,SAAS;AAAA,MACR;AAAA,QACC,KACC,KAAK,SAAS,iBACX;AAAA,UACA;AAAA,UACA;AAAA,QACD,IACC;AAAA,UACA;AAAA,UACA;AAAA,UACA,KAAK;AAAA,QACN;AAAA,QACH,WAAW;AAAA,MACZ;AAAA,IACD;AAAA,EACD,CAAC;AACF;AAEA,MAAM,UAAU,CACf,SACI;AACJ,SAAO,KAAK,OAAO,SAAS,iBAAiB,KAAK,SAAS;AAC5D;AAEO,MAAM,OAAO,WAAW;AAAA,EAC9B,OAAO,SAAS;AACf,WAAO;AAAA,MACN,oBAAoB,MAAmC;AACtD,YAAI,CAAC,KAAK,SAAS,QAAQ;AAC1B,iBAAO,SAAS,QAAQ,IAAI,CAAC;AAAA,QAC9B;